#!/usr/bin/env bash

. "$SETUP_PATH/lib"

log_step 'Installing neovim...'
sudo pacman -S --noconfirm --needed neovim || { log_error 'neovim installation failed'; return 1; }

log_step 'Installing tree-sitter-cli'
yay -S --noconfirm --needed tree-sitter-cli || { log_warn 'tree-sitter-cli installation failed'; }

log_step 'Installing neovim plugins...'
nvim --headless '+Lazy! sync' +qa || log_warn 'neovim sync failed'
